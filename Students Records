#include <iostream>
#include <vector>
#include <string>
#include <iomanip>
#include <algorithm>

using namespace std;

struct Student {
    string name;
    int id;
    vector<double> scores;
};

void addStudent(vector<Student>& students);
void displayStudents(const vector<Student>& students);
void calcAverage(const vector<Student>& students);
void displayMenu();

int main() {
    vector<Student> students;
    int choice;
    
    while (true) {
        displayMenu();
        cout << "Enter choice (1-4): ";
        cin >> choice;
        
        // Clear input buffer
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
        
        switch(choice) {
            case 1: addStudent(students); break;
            case 2: displayStudents(students); break;
            case 3: calcAverage(students); break;
            case 4: 
                cout << "\nGoodbye!" << endl;
                return 0;
            default:
                cout << "Invalid choice." << endl;
        }
    }
    
    return 0;
}

void displayMenu() {
    cout << "\n==============================" << endl;
    cout << "   STUDENT RECORD MENU" << endl;
    cout << "==============================" << endl;
    cout << "1. Add student" << endl;
    cout << "2. Display all" << endl;
    cout << "3. Calculate average" << endl;
    cout << "4. Quit" << endl;
    cout << "==============================" << endl;
}

void addStudent(vector<Student>& students) {
    Student newStudent;
    
    cout << "Student name: ";
    getline(cin, newStudent.name);
    
    if (newStudent.name.empty()) {
        cout << "Error: Name cannot be empty." << endl;
        return;
    }
    
    cout << "Student ID: ";
    cin >> newStudent.id;
    
    // Check for duplicate ID
    for (const Student& s : students) {
        if (s.id == newStudent.id) {
            cout << "Error: ID " << newStudent.id << " already exists." << endl;
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
            return;
        }
    }
    
    int numScores;
    cout << "How many scores? ";
    cin >> numScores;
    
    if (numScores <= 0) {
        cout << "Error: Number of scores must be positive." << endl;
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
        return;
    }
    
    newStudent.scores.clear();
    for (int i = 0; i < numScores; i++) {
        double score;
        cout << "Score " << (i + 1) << ": ";
        cin >> score;
        
        if (score < 0 || score > 100) {
            cout << "Error: Scores must be between 0 and 100." << endl;
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
            return;
        }
        
        newStudent.scores.push_back(score);
    }
    
    students.push_back(newStudent);
    cout << "Student \"" << newStudent.name << "\" added successfully." << endl;
    
    // Clear input buffer
    cin.ignore(numeric_limits<streamsize>::max(), '\n');
}

void displayStudents(const vector<Student>& students) {
    if (students.empty()) {
        cout << "\nNo students added yet." << endl;
        return;
    }
    
    cout << "\n-----------------------------------------------------------------" << endl;
    cout << left << setw(20) << "Name" 
         << setw(12) << "ID" 
         << setw(20) << "Scores" 
         << setw(10) << "Avg" << endl;
    cout << "-----------------------------------------------------------------" << endl;
    
    cout << fixed << setprecision(2);
    for (const Student& s : students) {
        double sum = 0;
        for (double score : s.scores) {
            sum += score;
        }
        double avg = (s.scores.empty()) ? 0 : sum / s.scores.size();
        
        string name = s.name;
        if (name.length() > 18) name = name.substr(0, 18);
        
        string scoresStr = "";
        for (size_t i = 0; i < s.scores.size(); i++) {
            scoresStr += to_string(s.scores[i]);
            if (i < s.scores.size() - 1) scoresStr += ", ";
        }
        if (scoresStr.length() > 18) scoresStr = scoresStr.substr(0, 18);
        
        cout << left << setw(20) << name 
             << setw(12) << s.id 
             << setw(20) << scoresStr 
             << right << setw(10) << avg << endl;
    }
    cout << "-----------------------------------------------------------------" << endl;
}

void calcAverage(const vector<Student>& students) {
    if (students.empty()) {
        cout << "\nNo students added yet." << endl;
        return;
    }
    
    int id;
    cout << "Enter student ID: ";
    cin >> id;
    
    // Find student
    const Student* found = nullptr;
    for (const Student& s : students) {
        if (s.id == id) {
            found = &s;
            break;
        }
    }
    
    if (!found) {
        cout << "Error: ID " << id << " not found." << endl;
        return;
    }
    
    if (found->scores.empty()) {
        cout << found->name << " has no scores." << endl;
        return;
    }
    
    double sum = 0;
    for (double score : found->scores) {
        sum += score;
    }
    double avg = sum / found->scores.size();
    
    cout << fixed << setprecision(2);
    cout << "\n" << found->name << "'s average: " << avg << endl;
    cout << "Scores: ";
    for (size_t i = 0; i < found->scores.size(); i++) {
        cout << found->scores[i];
        if (i < found->scores.size() - 1) cout << ", ";
    }
    cout << endl;
    
    // Clear input buffer
    cin.ignore(numeric_limits<streamsize>::max(), '\n');
}
