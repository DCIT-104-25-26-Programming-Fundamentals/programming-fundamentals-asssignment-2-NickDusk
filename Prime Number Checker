            int n = stoi(input);
            bool result = isPrime(n);
            cout << n << " is " << (result ? "PRIME" : "NOT PRIME") << endl;
        } catch (invalid_argument& e) {
            cout << "Please enter a valid integer or 'quit' or maybe you dont know integers go and try math 121 again" << endl;
        }
    }
    
    return 0;
}
