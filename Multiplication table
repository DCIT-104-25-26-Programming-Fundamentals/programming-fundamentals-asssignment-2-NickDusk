#include <iostream>
#include <iomanip>

using namespace std;

void partA() {
    try {
        int num;
        cout << "Enter a number: ";
        cin >> num;
        
        cout << "\nMultiplication Table for " << num << ":" << endl;
        cout << "------------------------------" << endl;
        
        for (int i = 1; i <= 12; i++) {
            cout << num << " x " << setw(2) << i << " = " << setw(3) << (num * i) << endl;
        }
    } catch (...) {
        cout << "Error: Please enter a valid integer." << endl;
    }
}

void partB() {
    try {
        int n;
        cout << "Enter a positive integer N: ";
        cin >> n;
        
        if (n <= 0) {
            cout << "Error: N must be a positive integer." << endl;
            return;
        }
        
        for (int num = 1; num <= n; num++) {
            cout << "\nMultiplication Table for " << num << ":" << endl;
            cout << "------------------------------" << endl;
            
            for (int i = 1; i <= 12; i++) {
                cout << num << " x " << setw(2) << i << " = " << setw(3) << (num * i) << endl;
            }
            
            if (num < n) {
                cout << "------------------------------" << endl;
            }
        }
    } catch (...) {
        cout << "Error: Please enter a valid integer." << endl;
    }
}

int main() {
    cout << "MULTIPLICATION TABLE GENERATOR" << endl;
    
    cout << "\n1. Single Table" << endl;
    cout << "2. Tables from 1 to N" << endl;
    
    int choice;
    cout << "\nEnter choice (1 or 2): ";
    cin >> choice;
    
    if (choice == 1) {
        partA();
    } else if (choice == 2) {
        partB();
    } else {
        cout << "Invalid choice." << endl;
    }
    
    return 0;
}
